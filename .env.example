# Copy to .env and fill in. .env is git-ignored — never commit real values.

# --- Postgres + pgvector ---
POSTGRES_USER=agentlab
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agentlab
POSTGRES_PORT=5432
DATABASE_URL=postgres://agentlab:change-me@localhost:5432/agentlab

# --- Redis ---
REDIS_PASSWORD=change-me
REDIS_PORT=6379
REDIS_URL=redis://:change-me@localhost:6379

# --- LLM providers (set spending caps in each console before using) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Cheapest-that-works defaults for development; override per run.
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_MODEL=

# --- GPU (gpu profile) ---
CUDA_IMAGE=nvidia/cuda:13.4.3-base-ubuntu24.04
